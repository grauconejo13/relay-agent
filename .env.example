# Relay AI intake mode: fallback | gemini
RELAY_INTAKE_MODE=fallback

# Gemini model
GEMINI_MODEL=gemini-3.5-flash

# Option A: Google AI Studio local development
GEMINI_API_KEY=

# Option B: Vertex AI / Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Local service URLs
NEXT_PUBLIC_RELAY_API_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API
RELAY_CORS_ORIGINS=http://localhost:3000

# Pub/Sub / Firestore placeholders for later milestones
RELAY_EVENTS_TOPIC=relay-events
RELAY_FIRESTORE_DATABASE=(default)
