# Google AI / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash

# Local service URLs
NEXT_PUBLIC_RELAY_API_URL=http://localhost:8000

# Pub/Sub / Firestore placeholders for later milestones
RELAY_EVENTS_TOPIC=relay-events
RELAY_FIRESTORE_DATABASE=(default)
